{
  "name": "webgllm",
  "version": "0.1.2",
  "description": "LLM inference in the browser on WebGL 2, for devices without WebGPU.",
  "license": "Apache-2.0",
  "author": "daveycodez",
  "homepage": "https://webgllm.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webgllm/webgllm.git",
    "directory": "packages/webgllm"
  },
  "bugs": "https://github.com/webgllm/webgllm/issues",
  "keywords": ["webgl", "webgl2", "llm", "inference", "browser", "local-ai", "gguf", "onnx", "lfm3", "qwen3.5", "openai"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "webgllm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "webgllm/source": "./src/advanced.ts",
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js",
      "default": "./dist/advanced.js"
    }
  },
  "files": ["src", "dist", "!**/*.test.ts", "!**/*.tsbuildinfo"],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "node scripts/test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/jinja": "0.5.10",
    "@huggingface/tokenizers": "0.2.0",
    "llguidance": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
