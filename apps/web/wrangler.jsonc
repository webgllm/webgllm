{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webgllm",
  "compatibility_date": "2026-11-05",
  // Static assets only: no Worker code runs.
  "assets": {
    "directory": "./.output/public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
